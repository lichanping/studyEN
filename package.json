{
  "name": "studyen",
  "private": true,
  "scripts": {
    "dev:local": "npx --yes netlify-cli@latest dev --port 8888",
    "dev:localhost": "bash ./scripts/dev_localhost.sh",
    "dev:localhost:check": "bash ./scripts/dev_localhost.sh --check",
    "build:reading-manifest": "node scripts/generate_reading_articles_manifest.js",
    "build:exam-prep-miniprogram": "node scripts/generate_exam_prep_miniprogram_assets.js",
    "fetch:reading-prepare": "node scripts/fetch_course_prepare_articles.js",
    "test:reading-articles": "node tests/test-reading-article-library.js",
    "test:reading-articles-regression": "node tests/test-reading-articles-page-regression.js",
    "test:reading-article-tooling-docs": "node tests/test-reading-article-tooling-docs.js",
    "test:reading-article-share-token": "node tests/test-reading-article-share-token.js",
    "test:reading-article-share-functions": "node tests/test-reading-article-share-functions.js",
    "test:exam-prep": "python3 -m pytest -q tests/test_exam_question_bank_converter.py && node tests/test-exam-prep-core.js && node tests/test-exam-prep-page-regression.js",
    "test:exam-prep-miniprogram": "node tests/test-exam-prep-miniprogram.js && node tests/test-exam-prep-miniprogram-page.js",
    "test:exam-prep-miniprogram:e2e": "node tests/test-exam-prep-miniprogram-e2e.js",
    "test:meeting-config": "node tests/test-meeting-config.js",
    "test:quota": "node tests/test-quota-check.js",
    "test:class-feedback": "node tests/test-class-feedback-stat-input.js",
    "test:stats-mode-and-review-deadline": "node tests/test-stats-mode-and-review-deadline.js",
    "test:anti-forgetting": "node tests/test-anti-forgetting-review-date-confirm.js && node tests/test-anti-forgetting-feedback.js && node tests/test-anti-forgetting-platform-ui.js && node tests/test-anti-forgetting-bfd-schedule.js && node tests/test-anti-forgetting-schedule.js",
    "test:schedule-match": "node tests/test-schedule-course-match.js",
    "test:schedule-subscription": "node tests/test-schedule-subscription.js && node tests/test-schedule-subscription-ui.js",
    "test:all": "npm run test:meeting-config && npm run test:quota && npm run test:class-feedback && npm run test:anti-forgetting && npm run test:schedule-match && npm run test:schedule-subscription && npm run test:stats-mode-and-review-deadline && node tests/test-student-name-alias.js",
    "rollback:sync": "bash ./scripts/rollback_sync.sh --target HEAD~1 --yes",
    "rollback:sync:dry": "bash ./scripts/rollback_sync.sh --target HEAD~1 --dry-run"
  },
  "dependencies": {
    "@andresaya/edge-tts": "^1.8.0",
    "@netlify/blobs": "^8.1.0",
    "nodemailer": "^8.0.11"
  },
  "devDependencies": {
    "fflate": "^0.8.3",
    "miniprogram-automator": "^0.12.1"
  }
}
